<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block dotfiles (.env, .git, dsb)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block Laravel internal folders (BUT NOT /storage/ karena itu symlink public)
RedirectMatch 403 ^/vendor/
RedirectMatch 403 ^/app/
RedirectMatch 403 ^/bootstrap/
RedirectMatch 403 ^/config/
RedirectMatch 403 ^/database/
RedirectMatch 403 ^/routes/
RedirectMatch 403 ^/tests/
RedirectMatch 403 ^/composer\.(json|lock)
RedirectMatch 403 ^/package(-lock)?\.json
RedirectMatch 403 ^/artisan
